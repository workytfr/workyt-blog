# Copier en .env.local et compléter. Ne jamais versionner les vraies valeurs.

# Adresse publique du blog (sans « / » final)
NEXT_PUBLIC_SITE_URL=https://blog.workyt.fr

# Base de données dédiée au blog (MongoDB)
MONGODB_URI=mongodb://localhost:27017/workyt-blog

# NextAuth
NEXTAUTH_URL=https://blog.workyt.fr
NEXTAUTH_SECRET=change-moi

# « Se connecter avec Workyt » (fournisseur OAuth / OpenID Connect de workyt.fr, lot 0)
WORKYT_URL=https://workyt.fr
WORKYT_CLIENT_ID=blog
WORKYT_CLIENT_SECRET=change-moi

# Connexion de développement (local uniquement, ignorée en production)
BLOG_DEV_LOGIN=0

# Images : hôtes autorisés pour next/image, séparés par des virgules
MEDIA_HOSTS=images.unsplash.com,foxitbl.workyt.fr,s3.youss.dev

# Mesure d'audience Umami (stats.youss.dev), site dédié au blog
NEXT_PUBLIC_UMAMI_URL=https://stats.youss.dev
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vérification Google Search Console par balise (option)
GOOGLE_SITE_VERIFICATION=

# Tâches planifiées (cron externe de l'hébergeur) : secret envoyé dans l'en-tête x-cron-secret
#   /api/cron/publish/      toutes les 5 min (publication programmée)
#   /api/cron/purge-trash/  chaque nuit (corbeille de plus de 30 jours)
#   /api/cron/check-links/  chaque nuit (liens affiliés morts)
CRON_SECRET=

# Banques d'images libres : clés gratuites sur pixabay.com/api/docs et pexels.com/api
PIXABAY_API_KEY=
PEXELS_API_KEY=
